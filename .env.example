# ===== MySQL (dùng chung máy chủ, mỗi dịch vụ một database riêng, tự tạo khi chạy lần đầu) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
# ===== Bảo mật =====
# Bắt buộc. Dùng chuỗi dài, ngẫu nhiên.
JWT_SECRET=replace_with_a_long_random_secret
# Tùy chọn: khóa nội bộ giữa các dịch vụ (mặc định suy ra từ JWT_SECRET)
# INTERNAL_KEY=
# Tài khoản dùng bởi scripts/seed.js và tests/e2e.test.js; phải khớp admin đã có trong DB.
# SQL demo mặc định đặt mật khẩu admin là 123456. Chỉ dùng mật khẩu demo ở môi trường thử nghiệm.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
# ===== Cổng (tùy chọn, đây là giá trị mặc định) =====
# GATEWAY_PORT=3000
# REGISTRY_PORT=3500
# EVENT_BUS_PORT=3600
