# Copy this file to .env and configure the local MySQL credentials.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_NAME=htqlns_auth

# Generate independent strong random secrets before deploying.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
INTERNAL_API_KEY=CHANGE_ME_DIFFERENT_LONG_RANDOM_INTERNAL_KEY
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

GATEWAY_URL=http://localhost:3000
REGISTRY_URL=http://localhost:3500
EVENT_BUS_URL=http://localhost:3600

AUTH_SERVICE_PORT=3001
ORGANIZATION_SERVICE_PORT=3002
ATTENDANCE_SERVICE_PORT=3003
LEAVE_SERVICE_PORT=3004
SHIFT_SERVICE_PORT=3005
PAYROLL_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008

# Change default seeded passwords before any real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
